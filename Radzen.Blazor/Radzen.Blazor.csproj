<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>BL9993;BL0007;BL0005</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RazorLangVersion>7.0</RazorLangVersion>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Radzen.Blazor.GAUSS</PackageId>
    <Product>Radzen.Blazor</Product>
    <Version>11.3.2.10</Version>
    <Copyright>Radzen Ltd.</Copyright>
    <Authors>Radzen Ltd. and GAUSS-LVS mbH</Authors>
    <Description>Radzen Blazor is the most sophisticated free UI component library for Blazor, featuring 110+ native components including DataGrid, Scheduler, Charts, and advanced theming with full support for Material Design and Fluent UI.</Description>
    <PackageTags>blazor material design fluent fluentui components datagrid scheduler charts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.radzen.com</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Radzen Components for Blazor</Title>
    <RepositoryUrl>https://github.com/radzenhq/radzen-blazor</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    NuGet symbol packages (.snupkg) require portable PDB files.
    Directory.Build.props in this repo uses DebugType=embedded by default, which produces no .pdb files and results
    in an effectively empty .snupkg. Force portable PDBs for Release/packing.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GAUSS.RadzenBase" Version="1.0.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.26" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.26" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Condition="'$(TargetFramework)' == 'net9.0'" Version="9.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Condition="'$(TargetFramework)' == 'net9.0'" Version="9.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Condition="'$(TargetFramework)' == 'net10.0'" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Condition="'$(TargetFramework)' == 'net10.0'" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LinkerConfig.xml">
      <LogicalName>$(MSBuildProjectName).xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Documents/Spreadsheet/theme1.xml" />
  </ItemGroup>

  <PropertyGroup>
    <RadzenMSBuildVersion>0.0.6</RadzenMSBuildVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.MSBuild" Version="$(RadzenMSBuildVersion)" PrivateAssets="All" />
  </ItemGroup>

  <!--
    NuGet imports a package's build/*.targets into the inner builds only. SassCompile and TerserMinify
    also have to run in the outer build (see CompileSass below), so the task declarations are imported
    here explicitly.
  -->
  <Import Project="$(NuGetPackageRoot)radzen.msbuild/$(RadzenMSBuildVersion)/build/Radzen.MSBuild.targets"
          Condition="'$(TargetFramework)' == '' and Exists('$(NuGetPackageRoot)radzen.msbuild/$(RadzenMSBuildVersion)/build/Radzen.MSBuild.targets')" />

  <!--
    wwwroot/css/*.css and wwwroot/Radzen.Blazor.min.js are build artefacts (gitignored), so the Razor SDK's
    wwwroot/** glob finds nothing on a clean checkout. They are removed here and re-added in
    AddGeneratedStaticWebAssets, which runs inside the build and therefore sees the generated files.
  -->
  <ItemGroup>
    <SassFile Include="$(MSBuildProjectDirectory)/themes/**/*.scss" />
    <Content Remove="wwwroot/Radzen.Blazor.min.js" />
    <Content Remove="wwwroot/css/**/*.css" />
  </ItemGroup>

  <!--
    Generation must happen once for the whole project, not per target framework: when packing a
    cross-targeting project the SDK packs the static web assets of a single inner build only
    (ResolveStaticWebAssetsEffectiveTargetFramework picks the lowest TFM, i.e. net8.0). Generating for
    net10.0 alone therefore produced a package without any CSS.
    Hooking DispatchToInnerBuilds runs the generation in the outer build before the inner builds are
    evaluated; the shared stamp under $(BaseIntermediateOutputPath) makes the inner builds skip it.
    A single-framework build (dotnet build -f netX) has no outer build and generates via
    AddGeneratedStaticWebAssets' DependsOnTargets.
  -->
  <Target Name="CompileSass" Inputs="@(SassFile)" Outputs="$(BaseIntermediateOutputPath)sass.stamp">
    <!-- The target runs before the compiler creates the intermediate dir, so the Touch below fails on a clean build. -->
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <SassCompile InputFiles="@(SassFile)" OutputStyle="compressed" />
    <Touch Files="$(BaseIntermediateOutputPath)sass.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="MoveCss" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="CompileSass">
    <ItemGroup>
        <CssFile Include="$(MSBuildProjectDirectory)/themes/*.css" />
    </ItemGroup>
    <Move SourceFiles="@(CssFile)" DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/css/" />
  </Target>

  <Target Name="MinifyJs" BeforeTargets="DispatchToInnerBuilds" Inputs="wwwroot/Radzen.Blazor.js" Outputs="wwwroot/Radzen.Blazor.min.js">
    <TerserMinify InputFile="wwwroot\Radzen.Blazor.js" OutputFile="wwwroot\Radzen.Blazor.min.js" />
  </Target>

  <!--
    Deliberately without Inputs/Outputs: an up-to-date check would skip the ItemGroup as well and the
    generated files would be missing from the static web asset manifest of that inner build.
  -->
  <Target Name="AddGeneratedStaticWebAssets" BeforeTargets="BeforeBuild" DependsOnTargets="MoveCss;MinifyJs" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
        <Content Include="wwwroot/css/**/*.css" />
        <Content Include="wwwroot/Radzen.Blazor.min.js" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Update="RadzenStrings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>RadzenStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="RadzenStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RadzenStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup Label="Allow internal method to be visible to the unit tests">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Radzen.Blazor.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Resources.NeutralResourcesLanguageAttribute">
      <_Parameter1>en</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
